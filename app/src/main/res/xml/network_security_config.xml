<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration

  By default, cleartext HTTP traffic is blocked.
  Users can enable "Allow HTTP (cleartext)" in Settings for trusted local networks.
  Self-signed TLS certificates can be explicitly trusted per-host.

  NOTE: Android's network-security-config does not support CIDR notation for IP
  ranges.  The cleartext-permitted domain-config below covers only the gateway
  addresses of the common RFC 1918 private subnets.  If your LM Studio server has
  a different IP address, install this app from source and add your server's IP to
  this file, OR use HTTPS which is always permitted.
-->
<network-security-config>
    <!--
      Allow cleartext (HTTP) traffic to any host on the three private IPv4
      ranges, represented here by a broad subdomain wildcard on each /8 or
      /16 gateway.  This is the most permissive that static XML config allows;
      it covers the overwhelming majority of home / office LAN addresses.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- 192.168.x.x (common home router range) -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <!-- 10.x.x.x -->
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">10.0.1.0</domain>
        <!-- 172.16.x.x – 172.31.x.x -->
        <domain includeSubdomains="true">172.16.0.0</domain>
        <domain includeSubdomains="true">172.17.0.0</domain>
        <domain includeSubdomains="true">172.20.0.0</domain>
        <!-- Loopback for development -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- All other connections must use HTTPS/TLS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust system CAs -->
            <certificates src="system" />
            <!-- Trust user-installed CAs (for self-signed certs) when enabled -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
